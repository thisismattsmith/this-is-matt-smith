---
import WorkLayout from '@layouts/work-layout.astro';
import { ScrollProgress } from '@components/misc';
import { type CollectionEntry, getCollection } from 'astro:content';
import { getReadingTime } from '@utils/index';
import ExternalLink from "../../components/misc/ExternalLink.astro";

export async function getStaticPaths() {
	const posts = await getCollection('work');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

type Props = { post: CollectionEntry<'work'> };

const { post } = Astro.props;
const { Content } = await post.render();
const readingTime = getReadingTime(post.body);
---

<WorkLayout {...post.data} >
	<Content components={{ a: ExternalLink }} />
	<ScrollProgress />
</WorkLayout>
