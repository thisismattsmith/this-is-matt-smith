---
import WritingLayout from '@layouts/writing-layout.astro';
import { ScrollProgress } from '@components/misc';
import { type CollectionEntry, getCollection } from 'astro:content';
import { getReadingTime } from '@utils/index';
import ExternalLink from "../../components/misc/ExternalLink.astro";

// Required for static output: enumerate every post as a build-time route.
export async function getStaticPaths() {
	const posts = await getCollection('writing');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

type Props = { post: CollectionEntry<'writing'> };

const { post } = Astro.props;
const { Content } = await post.render();
const readingTime = getReadingTime(post.body);
---

<WritingLayout {...post.data} readingTime={readingTime}>
	<Content components={{ a: ExternalLink }} />
	<ScrollProgress />
</WritingLayout>
