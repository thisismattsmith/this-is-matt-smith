---
import LogLayout from '@layouts/log-layout.astro';
import { ScrollProgress } from '@components/misc';
import { type CollectionEntry, getCollection } from 'astro:content';
import { getReadingTime } from '@utils/index';
import ExternalLink from "../../components/misc/ExternalLink.astro";

export async function getStaticPaths() {
	const posts = await getCollection('log');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

type Props = { post: CollectionEntry<'log'> };

const { post } = Astro.props;
const { Content } = await post.render();
const readingTime = getReadingTime(post.body);
---
<LogLayout {...post.data} readingTime={readingTime}>
	<Content components={{ a: ExternalLink }} />
	<ScrollProgress />
</LogLayout>
