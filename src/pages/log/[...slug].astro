---
import LogLayout from '@layouts/log-layout.astro';
import { ScrollProgress } from '@components/misc';
import { type CollectionEntry, getCollection } from 'astro:content';
import { getReadingTime } from '@utils/index';
import ExternalLink from "../../components/misc/ExternalLink.astro";

const posts = await getCollection('log');
type Props = CollectionEntry<'log'>;

const { slug } = Astro.params;
const post = posts.find((page) => page.slug === slug);

if (!post) return Astro.redirect('/404');

const { Content } = await post.render();
const readingTime = getReadingTime(post.body);

---
<LogLayout {...post.data} readingTime={readingTime}>
	<Content components={{ a: ExternalLink }} />
	<ScrollProgress />
</LogLayout>
