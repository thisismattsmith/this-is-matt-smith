---
import FormattedDate from '@components/misc/formatted-date.astro';
import { clsx, getCategoryAccent } from '@utils/index';

const { category, content, pubDate, slug } = Astro.props;
const accent = getCategoryAccent(category);
---

<a href={`/thoughts/${slug}`} class='block'>
	<article
		id={category}
		class={clsx(
			// Subtle card; category colour shows up only on the small pill.
			// No left border bar. Same hover behaviour as /work cards.
			'flex flex-col items-start gap-3 w-full p-5 relative border border-gray-200 dark:border-neutral-800 rounded-lg bg-white dark:bg-neutral-900',
			'transition-transform duration-200 ease-in-out transform hover:rotate-1 hover:border-black dark:hover:border-white hover:shadow-md'
		)}>
		<p class='text-gray-500 dark:text-gray-400 text-sm font-medium'>
			a thought about
			<span
				class={clsx(
					'inline-block px-1.5 py-0.5 rounded font-medium',
					accent.bg,
					accent.text
				)}>
				{category}
			</span>
		</p>
		<h3
			class='text-gray-900 dark:text-gray-100 font-medium w-full text-lg md:text-xl tracking-tight'>
			{content}
		</h3>
		<p class='w-full text-end text-gray-500 dark:text-gray-500 text-xs font-medium'>
			<FormattedDate date={pubDate} />
		</p>
	</article>
</a>
